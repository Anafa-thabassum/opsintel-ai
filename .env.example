# Exasol Personal defaults
EXASOL_DSN=127.0.0.1:8563
EXASOL_USER=sys
# Prefer EXASOL_PASSWORD for non-local deployments. Leave it unset to use
# the Exasol Personal secrets file below.
EXASOL_PASSWORD=
EXASOL_SECRETS_PATH=~/.exasol/personal/deployments/default/secrets.json
# Local Exasol Personal commonly uses a self-signed certificate.
EXASOL_TLS_VERIFY=false
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
