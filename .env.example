# Exasol Personal defaults
EXASOL_DSN=127.0.0.1:8563
# The sys account is only for this local synthetic demo. Use a dedicated,
# least-privileged application identity for any non-local deployment.
EXASOL_USER=sys
# Prefer EXASOL_PASSWORD for non-local deployments. Leave it unset to use
# the Exasol Personal secrets file below.
EXASOL_PASSWORD=
EXASOL_SECRETS_PATH=~/.exasol/personal/deployments/default/secrets.json
# Local Exasol Personal commonly uses a self-signed certificate. Remote DSNs
# are rejected unless certificate verification is enabled.
EXASOL_TLS_VERIFY=false
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optional narrative summarizer. Keep disabled for the deterministic-only mode.
OPSINTEL_LLM_ENABLED=false
OPENAI_API_KEY=
OPSINTEL_LLM_MODEL=gpt-6-luna
OPSINTEL_LLM_TIMEOUT_SECONDS=10

# Verified memory is disabled until explicit engineer grants are configured.
# Supply JSON from a local secret manager; never commit real tokens.
# Example shape: {"long-random-token":{"actor_id":"engineer-1","role":"investigator"},"another-token":{"actor_id":"reviewer-1","role":"reviewer"}}
OPSINTEL_AUTH_TOKENS_JSON=

# Optional GitHub API token for higher public-issue ingestion rate limits.
# Read-only issue retrieval works without it. Keep the token server-side.
GITHUB_TOKEN=


